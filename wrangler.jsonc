{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-startup",
  "account_id": "c336fa03613cb6253dcdf6941872f343",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "vars": {
    "AI_GATEWAY_ACCOUNT_ID": "c336fa03613cb6253dcdf6941872f343",
    "AI_GATEWAY_ID": "default",
    "ANTHROPIC_API_KEY": "rubii-anthropic",
    "OPENAI_API_KEY": "rubii-openai",
    "GEMINI_API_KEY": "rubii-gemini",
    "DEEPSEEK_API_KEY": "rubii-deepseek"
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CounterAgent",
        "class_name": "CounterAgent"
      },
      {
        "name": "ChatAgent",
        "class_name": "ChatAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CounterAgent"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ChatAgent"]
    }
  ]
}
